#!/usr/bin/make -f

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_install:
ifeq ($(DEB_HOST_ARCH),arm64)
	mkdir -p $(CURDIR)/debian/ath11k-fwtest/usr/sbin
	cp -a ath11k-fwtest/arm64/usr/sbin/* $(CURDIR)/debian/ath11k-fwtest/usr/sbin/
endif
	:

# binaries are already stripped
override_dh_dwz: ;
